# HTTP server
PORT=3100

# Protect POST /send (required in production)
WHATSAPP_WEB_SERVICE_API_KEY=

# Persistent LocalAuth session directory (mount a Railway volume here)
WWEBJS_AUTH_DATA_PATH=./data/wwebjs-auth

# Optional override only for local debugging. Production Docker/Railway uses
# Puppeteer's bundled Chrome for Testing from PUPPETEER_CACHE_DIR.
# PUPPETEER_EXECUTABLE_PATH=

# Puppeteer browser cache (set automatically in Docker)
# PUPPETEER_CACHE_DIR=/app/.cache/puppeteer

# Pin WhatsApp Web HTML (Docker downloads this into WHATSAPP_WEB_CACHE_PATH)
# WHATSAPP_WEB_VERSION=2.3000.1046816453-alpha
# WHATSAPP_WEB_CACHE_PATH=/app/.wwebjs_cache

# Puppeteer headless mode: true (modern --headless=new) or shell (classic --headless)
# PUPPETEER_HEADLESS=true

# Puppeteer CDP protocol timeout for page.evaluate/send operations (ms)
# PUPPETEER_PROTOCOL_TIMEOUT_MS=120000

# HTTP /send guard timeout while waiting for WhatsApp Web (ms)
# WHATSAPP_SEND_TIMEOUT_MS=90000
