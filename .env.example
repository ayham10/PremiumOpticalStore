# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional overrides
# SUPABASE_STORE_TABLE=lumina_store
# SUPABASE_STORE_ID=default
# SUPABASE_MEDIA_BUCKET=lumina-media

# Auth (role-based admin dashboard)
AUTH_SECRET=replace-with-long-random-string
ADMIN_EMAIL=admin@lumina.optics
ADMIN_PASSWORD=lumina2024
EMPLOYEE_PASSWORD=employee2024
RECEPTIONIST_PASSWORD=reception2024

# SMS provider: console | twilio | messagebird | custom
SMS_PROVIDER=console
SMS_FROM_NUMBER=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MessageBird
MESSAGEBIRD_API_KEY=
MESSAGEBIRD_ORIGINATOR=

# Custom SMS gateway
SMS_CUSTOM_ENDPOINT=
SMS_CUSTOM_API_KEY=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
